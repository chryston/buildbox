{
  "name": "buildbox",
  "private": true,
  "version": "0.0.0",
  "homepage": "https://chryston.github.io/buildbox",
  "type": "module",
  "scripts": {
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "npm run typecheck && vite build && node scripts/check-size-budget.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:screenshots": "node scripts/run-screenshots.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "immer": "^10.1.1",
    "nanoid": "^5.1.11",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zundo": "^2.3.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.62.1",
    "@tailwindcss/forms": "^0.5.10",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/ui": "^3.2.2",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.5",
    "eslint-plugin-boundaries": "^5.4.0",
    "fast-check": "^4.10.2",
    "gh-pages": "^6.3.0",
    "globals": "^17.14.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.2"
  }
}
